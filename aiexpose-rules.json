    {
      "id": "STEAL-WALLET",
      "title": "Reads cryptocurrency wallet files",
      "severity": "critical",
      "pattern": "(?i)\\b(?:wallet\\.dat|Ethereum[\\\\/]keystore|Exodus[\\\\/]exodus\\.wallet|Electrum[\\\\/]wallets|MetaMask)\\b"
    },
    {
      "id": "STEAL-SSH",
      "title": "Reads SSH or cloud credential files",
      "severity": "high",
      "pattern": "(?:\\.ssh[\\\\/]id_(?:rsa|ed25519)|\\.aws[\\\\/]credentials|\\.config[\\\\/]gcloud[\\\\/]credentials)"
    },
    {
      "id": "OBF-EXEC",
      "title": "Executes a decoded or decompressed payload",
      "severity": "critical",
      "pattern": "(?:exec|eval)\\s*\\(\\s*(?:__import__\\s*\\(\\s*['\\\"]base64|base64\\.b64decode|codecs\\.decode|zlib\\.decompress|marshal\\.loads|bytes\\.fromhex)"
    },
    {
      "id": "OBF-PWSH",
      "title": "Runs an encoded PowerShell command",
      "severity": "critical",
      "pattern": "(?i)powershell[^\\n]{0,80}(?:-enc\\b|-encodedcommand|-w\\s+hidden|-windowstyle\\s+hidden)"
    },
    {
      "id": "NET-PIPE",
      "title": "Pipes a downloaded script straight into a shell",
      "severity": "high",
      "pattern": "(?:curl|wget)[^\\n|]{0,120}\\|\\s*(?:ba)?sh\\b"
    },
    {
      "id": "PERSIST",
      "title": "Installs itself for automatic startup",
      "severity": "high",
      "pattern": "(?i)(?:CurrentVersion\\\\\\\\Run|crontab\\s+-|LaunchAgents[\\\\/][^\\n]+\\.plist|systemctl\\s+enable)"
    }
