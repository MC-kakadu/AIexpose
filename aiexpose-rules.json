  "entries": [
    {
      "id": "AIX-2025-0001",
      "kind": "package",
      "match": "postmark-mcp",
      "severity": "critical",
      "title": "postmark-mcp was backdoored after months of legitimate use",
      "detail": "An MCP server published on npm behaved normally long enough to gain real users, then shipped a version that silently copied every email it sent to an address controlled by its author. It had roughly 1,500 weekly downloads and around 300 organisations had already integrated it when the change was found. The package has been removed from npm, so any local copy is a version that should not be trusted.",
      "reference": "https://www.koi.security/blog/postmark-mcp-npm-malicious-backdoor-email-theft",
      "added": "2025-09-26"
    },
    {
      "id": "AIX-2024-0002",
      "kind": "node-name",
      "match": "ComfyUI_LLMVISION",
      "severity": "critical",
      "title": "ComfyUI_LLMVISION is an information stealer disguised as a workflow node",
      "detail": "Distributed through community channels as a helpful extension, it hid its payload inside fake OpenAI and Anthropic installation files. Once loaded it collected browser-saved passwords, credit card details, browsing history, clipboard contents, screenshots and cryptocurrency wallets, and sent them to a Discord webhook. If this is installed, treat every credential reachable from the machine as compromised.",
      "reference": "https://www.vpnmentor.com/news/comfyui-malicious-custom-node/",
      "added": "2024-06-09"
    },
    {
      "id": "AIX-2026-0003",
      "kind": "package",
      "match": "easy-day-js",
      "severity": "critical",
      "title": "easy-day-js is a typosquat used to backdoor Mastra packages",
      "detail": "A typosquatted dependency that was pulled into the build of more than 140 npm packages in the Mastra ecosystem, backdooring each of them. The name exists only to be mistaken for a legitimate date library.",
      "reference": "https://www.stepsecurity.io/blog/mastra-npm-packages-compromised-using-easy-day-js",
      "added": "2026-03-01"
    }
  ],
